            "value": "すべてを表示"
          }
        }
      }
    },
    "Show Cursor": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルを表示"
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ"
          }
        }
      }
    },
    "Zoom": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大/縮小"
          }
