{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%lld fps": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fps"
          }
        }
      }
    },
    "1. Open System Settings.\n2. Drag the DeskPad icon below into the Screen Recording list.\n3. Reopen DeskPad.\n\nIf DeskPad is already listed, turn it off and on again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. システム設定を開きます。\n2. 下の DeskPad アイコンを「画面収録」のリストにドラッグします。\n3. DeskPad を開き直します。\n\nすでにリストにある場合は、一度オフにしてからオンに戻してください。"
          }
        }
      }
    },
    "About DeskPad": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeskPad について"
          }
        }
      }
    },
    "Allow DeskPad to record the screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeskPad に画面収録を許可してください"
          }
        }
      }
    },
    "Bring All to Front": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてを手前に移動"
          }
        }
      }
    },
    "Bring to Front When Cursor Enters": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルが入ったら手前に表示"
          }
        }
      }
    },
    "Display": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイ"
          }
        }
      }
    },
    "Drag into the Screen Recording list": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「画面収録」のリストにドラッグ"
          }
        }
      }
    },
    "Drag me": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグしてください"
          }
        }
      }
    },
    "Frame Rate": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームレート"
          }
        }
      }
    },
    "Hide DeskPad": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeskPad を非表示"
          }
        }
      }
    },
    "Hide Others": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかを非表示"
          }
        }
      }
    },
    "Keep on Top": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に手前に表示"
          }
        }
      }
    },
    "Minimize": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しまう"
          }
        }
      }
    },
    "No Resolutions Available": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できる解像度がありません"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        }
      }
    },
    "Quit DeskPad": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeskPad を終了"
          }
        }
      }
    },
    "Reopen DeskPad": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeskPad を開き直す"
          }
        }
      }
    },
    "Resolution": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解像度"
          }
        }
      }
    },
    "Rotate": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転"
          }
        }
      }
    },
    "Screen Recording Permission": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録の許可"
          }
        }
